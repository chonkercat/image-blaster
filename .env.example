# Required for all image, 3D model, environment mesh, and resource generation.
TRIPO_API_KEY=your_tripo_key_here

# Optional Tripo model/region configuration.
TRIPO_API_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_IMAGE_MODEL=seedream_v5

# Optional: ElevenLabs sound effects through FAL. Leave empty to disable sound.
FAL_KEY=

# Use your normal Claude subscription/API configuration for analysis and planning.
# Never put general AI credentials in browser code or use them to generate assets.
