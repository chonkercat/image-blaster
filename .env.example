# Master switch: tripo OR original (World Labs environments + FAL images/models/resources).
# Leave per-provider overrides unset to switch the entire stack with this one value.
ASSET_GENERATION_STACK=tripo

# Tripo stack; this key is only required when using Tripo providers.
TRIPO_API_KEY=your_tripo_key_here

# Optional Tripo model/region configuration.
TRIPO_API_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_IMAGE_MODEL=seedream_v5

# Original stack; both keys are required for the full workflow.
# FAL is also used for optional ElevenLabs sound effects in either stack.
WORLD_LABS_API_KEY=
FAL_KEY=
WORLD_LABS_MODEL=marble-1.1

# Optional overrides for mixed stacks (uncomment only when needed).
# Image provider: tripo | nano-banana | gpt-image-2
# ASSET_IMAGE_EDIT_PROVIDER=nano-banana
# Model provider: tripo | hunyuan | meshy
# ASSET_3D_PROVIDER=hunyuan
# World provider: tripo | world-labs
# ASSET_WORLD_PROVIDER=world-labs

# Use your normal Claude subscription/API configuration for analysis and planning.
# Never put general AI credentials in browser code or use them to generate assets.
